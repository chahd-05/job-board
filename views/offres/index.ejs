<%- include("../partials/header", { pageTitle: "Liste des offres" }) %>

<main>

    <section class="search-section">
        <h2>Rechercher et filtrer les offres</h2>

        <form class="search-form" action="/offres" method="GET">

        <input
            type="text"
            class="search-input"
            name="search"
            placeholder="Rechercher..."
            value="<%= search %>"
        >

        <input
            type="text"
            class="search-input"
            name="ville"
            placeholder="Ville"
            value="<%= ville %>"
        >

        <input
            type="text"
            class="search-input"
            name="typeContrat"
            placeholder="Type de contrat"
            value="<%= typeContrat %>"
        >

        <input
            type="text"
            class="search-input"
            name="technologie"
            placeholder="Technologie"
            value="<%= technologie %>"
        >

        <div class="sort">
        <label for="sort">Trier par :</label>
        <select class="search-select" id="sort" name="sort">

            <option
                value="desc"
                <%= sort === "desc" ? "selected" : "" %>
            >
                Plus récentes
            </option>

            <option
                value="asc"
                <%= sort === "asc" ? "selected" : "" %>
            >
                Plus anciennes
            </option>

        </select>
        </div>

        <button class="search-button" type="submit">
            Rechercher
        </button>

        </form>
    </section>

    <div class="offers-header">
        <h1>Offres disponibles <span>(<%= offres.length %> opportunités)</span></h1>
        <a class="details-button" href="/offres/suivies">Consulter mes offres suivies</a>
    </div>

    <% if (offres.length === 0) { %>

        <p>Aucune offre trouvée.</p>

    <% } else { %>


        <% offres.forEach(offre => { %>

            <article
                class="job-card"
                data-offer-id="<%= offre.id %>"
                data-offer-title="<%= offre.titre %>"
                data-offer-company="<%= offre.entreprise_name %>"
                data-offer-city="<%= offre.ville %>"
                data-offer-contract="<%= offre.typeContrat %>"
            >

                <div class="job-header">
                    <div>
                        <h3><%= offre.titre %></h3>
                        <p><%= offre.entreprise_name %> — <%= offre.ville %></p>
                    </div>
                    <span class="job-type"><%= offre.typeContrat %></span>
                </div>

                <p class="job-description"><%= offre.descriptionCourte %></p>

                <div class="job-footer">
                    <small>Publié le <%= offre.datePublication %></small>
                    <div>
                        <button class="follow-button" type="button" data-follow-offer>
                            Suivre
                        </button>
                        <a class="details-button" href="/offres/<%= offre.id %>">Consulter</a>
                    </div>
                </div>

            </article>

        <% }) %>


    <% } %>

</main>

    <script src="/js/storage.js" defer></script>
<%- include("../partials/footer") %>