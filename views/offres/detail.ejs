<%- include("../partials/header", { pageTitle: offre.titre }) %>

<main>
    <a class="back-link" href="/offres">Retour aux offres</a>

    <div class="job-detail">
        <article class="job-detail-content">
            <div class="job-detail-header">
                <h1><%= offre.titre %></h1>
                <span class="job-type"><%= offre.typeContrat %></span>
            </div>

            <p class="job-info">
                <strong>Entreprise :</strong> <%= offre.entreprise_name %> |
                <strong>Ville :</strong> <%= offre.ville %> |
                <strong>Publié le :</strong> <%= offre.datePublication %>
            </p>

            <h3>Description</h3>
            <p><%= offre.descriptionLongue %></p>

            <h3>Profil recherché</h3>
            <p><%= offre.profilRecherche %></p>
        </article>

        <aside class="job-detail-sidebar">
            <h3>Technologies requises</h3>

            <% if (technologies.length === 0) { %>
                <p>Aucune technologie renseignée.</p>
            <% } else { %>
                <div class="technologies">
                    <% technologies.forEach(technologie => { %>
                        <span><%= technologie.nom %></span>
                    <% }) %>
                </div>
            <% } %>

            <h3>À propos de l'entreprise</h3>
            <p><%= offre.entreprise_name %></p>

            <% if (offre.lienCandidature) { %>
                <p>
                    <a class="apply-button" href="<%= offre.lienCandidature %>">
                        Postuler à cette offre
                    </a>
                </p>
            <% } %>

            <% if (offre.emailContact) { %>
                <p><a href="mailto:<%= offre.emailContact %>"><%= offre.emailContact %></a></p>
            <% } %>
        </aside>
    </div>
</main>

<%- include("../partials/footer") %>